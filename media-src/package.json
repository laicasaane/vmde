{
  "name": "media-src",
  "version": "0.0.0",
  "private": "true",
  "scripts": {
    "start": "node build.mjs --watch",
    "build": "node build.mjs",
    "test": "echo 'Unit tests are consolidated under vitest — run `npm test` from the repo root.' && exit 1",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:coverage": "E2E_COVERAGE=1 playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots"
  },
  "browserslist": "> 0%",
  "devDependencies": {
    "@playwright/cli": "^0.1.18",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "d3": "7.9.0",
    "esbuild": "^0.28.2",
    "monocart-coverage-reports": "^2.13.0",
    "three": "^0.185.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "dompurify": "3.4.13",
    "roughjs": "^4.6.6",
    "vditor": "^3.11.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
